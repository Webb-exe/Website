---
import "../styles/global.css";
import { Font, getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Navigation from "../components/shared/Navigation.astro";
import Footer from "../components/shared/Footer.astro";
import Loader from "../components/shared/Loader.astro";
import Analytics from "../components/shared/Analytics.astro";
import UnderConstruction from "../components/shared/UnderConstruction.astro";
import ogSource from "../assets/2e8c74a1-f585-4be5-a641-f0a44a202559.png";

interface Props {
  title?: string;
  description?: string;
  /** Render the under-construction screen instead of this page's content. */
  maintenance?: boolean;
}

const {
  title = "359 Webb.exe | Robotics Team",
  description = "359 Webb.exe is a competitive FIRST Tech Challenge robotics team from The Webb Schools. Creators, innovators, solvers.",
  maintenance = false,
} = Astro.props;

const og = await getImage({ src: ogSource, width: 1200, format: "jpg" });
const ogUrl = new URL(og.src, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-serif-custom" preload />
    <Font cssVariable="--font-hand" preload />

    <script is:inline>document.documentElement.classList.add("js");</script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="92392a19-bba5-4388-a744-7977ae6878e7"></script>

    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <Loader />
    {maintenance ? (
      <main>
        <UnderConstruction />
      </main>
    ) : (
      <>
        <Navigation transition:persist="main-nav" />
        <main>
          <slot />
        </main>
        <Footer transition:persist="main-footer" />
      </>
    )}

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";
      import { gsap, ScrollTrigger, prefersReducedMotion } from "../lib/gsap";

      let lenis: Lenis | null = null;

      gsap.ticker.add((time) => lenis?.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      function startLenis() {
        lenis?.destroy();
        if (prefersReducedMotion()) {
          lenis = null;
          return;
        }
        lenis = new Lenis({
          duration: 1.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
        lenis.on("scroll", ScrollTrigger.update);
      }

      // Fires on initial load and after every client-side navigation.
      document.addEventListener("astro:page-load", () => {
        startLenis();
        requestAnimationFrame(() => ScrollTrigger.refresh());
      });

      // Astro replaces every <html> attribute on swap, which drops the `js` class set in <head>.
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("js");
      });

      document.addEventListener("astro:before-swap", () => {
        ScrollTrigger.getAll().forEach((st) => st.kill());
        lenis?.destroy();
        lenis = null;
      });
    </script>
  </body>
</html>
