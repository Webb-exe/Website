---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Navigation from "../components/shared/Navigation.astro";
import Footer from "../components/shared/Footer.astro";
import LoadingAnimation from "../components/shared/LoadingAnimation.astro";

interface Props {
  title?: string;
}

const { title = "359 Webb.exe | Robotics Team" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="359 Webb.exe - Creators, Innovators, Solvers. A competitive robotics team pushing the boundaries of engineering."
    />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="359 Webb.exe - Creators, Innovators, Solvers. A competitive robotics team pushing the boundaries of engineering."
    />
    <meta
      property="og:image"
      content="/2e8c74a1-f585-4be5-a641-f0a44a202559.PNG"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="359 Webb.exe - Creators, Innovators, Solvers. A competitive robotics team pushing the boundaries of engineering."
    />
    <meta
      name="twitter:image"
      content="/2e8c74a1-f585-4be5-a641-f0a44a202559.PNG"
    />

    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="92392a19-bba5-4388-a744-7977ae6878e7"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-serif-custom" preload />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <LoadingAnimation />
    <Navigation transition:persist="main-nav" />
    <slot />
    <Footer transition:persist="main-footer" />

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      // Register ScrollTrigger
      gsap.registerPlugin(ScrollTrigger);

      // Track ready state
      let isReady = false;
      let lenis: Lenis | null = null;

      function initLenis() {
        // Kill existing instance if any
        if (lenis) {
          lenis.destroy();
          lenis = null;
        }

        // Create new Lenis instance
        lenis = new Lenis({
          duration: 1.4,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: 0.8,
        });

        // Store on window for other components
        (window as any).lenis = lenis;

        // Sync with GSAP
        lenis.on("scroll", ScrollTrigger.update);

        gsap.ticker.add((time) => {
          if (lenis) {
            lenis.raf(time * 1000);
          }
        });

        gsap.ticker.lagSmoothing(0);

        // Start scrolling immediately if already ready
        if (isReady) {
          lenis.start();
        } else {
          lenis.stop();
          document.body.style.overflow = "hidden";
        }
      }

      function enableScrolling() {
        isReady = true;
        document.body.style.overflow = "";

        if (lenis) {
          lenis.start();
        }

        // Scroll to top
        window.scrollTo(0, 0);
        if (lenis) {
          lenis.scrollTo(0, { immediate: true });
        }

        // Refresh ScrollTrigger after a short delay
        setTimeout(() => {
          ScrollTrigger.refresh();
        }, 100);
      }

      // Initialize on page load
      function init() {
        initLenis();

        // Check session storage to see if we should enable immediately
        const hasVisited = sessionStorage.getItem("ftc359_visited");
        if (hasVisited) {
          // Return visit - enable immediately
          enableScrolling();
        }
      }

      // Start initialization
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }

      // Listen for loading animation completion
      window.addEventListener("loading-animation-complete", enableScrolling);

      // Handle page transitions
      document.addEventListener("astro:page-load", () => {
        // Re-initialize Lenis for new page
        initLenis();

        // Enable immediately since initial load is complete
        if (isReady || sessionStorage.getItem("ftc359_visited")) {
          isReady = true;
          enableScrolling();
        }
      });

      // Cleanup ScrollTrigger on page leave
      document.addEventListener("astro:before-swap", () => {
        // Kill all ScrollTriggers to prevent memory leaks
        ScrollTrigger.getAll().forEach((st) => st.kill());
      });

      // Expose ScrollTrigger for components
      (window as any).ScrollTrigger = ScrollTrigger;
    </script>
  </body>
</html>
