---
// LoadingAnimation.astro - Smart loading with first-visit detection
// Shows full logo animation only on first visit, quick transition on navigation
---

<!-- Initial Load Overlay - Only shows on first visit to the site -->
<div 
  id="initial-loader" 
  class="fixed inset-0 z-9999 flex items-center justify-center bg-dark"
  style="opacity: 1;"
>
  <div class="w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48">
    <svg
      id="loading-logo"
      data-name="Layer 1"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 159.59 76.99"
      class="w-full h-full"
    >
      <defs>
        <style>
          .cls-1 { fill: #a6a6a6; stroke: #a6a6a6; stroke-width: 1; stroke-miterlimit: 10; }
          .cls-2 { fill: #ffd5e0; stroke: #ffd5e0; stroke-width: 1; stroke-miterlimit: 10; }
          .cls-3 { fill: #fdb4b9; stroke: #fdb4b9; stroke-width: 1; stroke-miterlimit: 10; }
        </style>
      </defs>
      <path class="cls-1" d="M69.97,38.51C60.87,25.84,51.78,13.17,42.69.5H.67v12.94h46.78s.02,17.03.02,17.03h-24.21s0,12.92,0,12.92h23.82v18.86s-46.58,0-46.58,0l.08,14.25h42.1l27.28-37.98Z"/>
      <path class="cls-3" d="M89.62,38.51c9.09-12.67,18.19-25.34,27.28-38.01h42.01v12.94h-46.78s-.02,17.03-.02,17.03h24.21s0,12.92,0,12.92h-23.82v18.86s46.58,0,46.58,0l-.08,14.25h-42.1l-27.28-37.98Z"/>
      <polygon class="cls-2" points="61.75 .5 79.42 25.09 96.78 .5 61.75 .5"/>
      <polygon class="cls-2" points="62.58 76.49 80.25 51.9 97.61 76.49 62.58 76.49"/>
    </svg>
  </div>
</div>

<!-- Page Transition Overlay - Shows during navigation -->
<div 
  id="page-transition" 
  class="fixed inset-0 z-9998 pointer-events-none flex items-center justify-center"
  style="opacity: 0; visibility: hidden;"
>
  <div class="absolute inset-0 bg-dark"></div>
  <div class="relative z-10 flex flex-col items-center gap-4">
    <!-- Simple loading spinner -->
    <div class="loading-spinner w-8 h-8 border-2 border-accent/30 border-t-accent rounded-full"></div>
    <span class="text-xs uppercase tracking-widest text-white/50">Loading</span>
  </div>
</div>

<style>
  .loading-spinner {
    animation: spin 0.8s linear infinite;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import gsap from 'gsap';

  // Session key to track first visit
  const SESSION_KEY = 'ftc359_visited';
  
  let initialLoaderComplete = false;
  let isNavigating = false;

  function isFirstVisit(): boolean {
    if (typeof sessionStorage === 'undefined') return true;
    return !sessionStorage.getItem(SESSION_KEY);
  }

  function markVisited(): void {
    if (typeof sessionStorage !== 'undefined') {
      sessionStorage.setItem(SESSION_KEY, 'true');
    }
  }

  function resetSVGElements(svg: SVGElement) {
    const allElements = svg.querySelectorAll('path, polygon');
    allElements.forEach((element) => {
      gsap.killTweensOf(element);
      const length = (element as SVGGeometryElement).getTotalLength();
      gsap.set(element, {
        strokeDasharray: length,
        strokeDashoffset: length,
        fillOpacity: 0,
      });
    });
  }

  function runInitialAnimation() {
    const container = document.getElementById('initial-loader');
    const svgElement = document.getElementById('loading-logo');
    const svg = svgElement instanceof SVGElement ? svgElement : null;
    
    if (!svg || !container) {
      // If no elements, just dispatch complete
      completeInitialLoad();
      return;
    }

    // Reset SVG
    resetSVGElements(svg);

    const paths = svg.querySelectorAll('path');
    const polygons = svg.querySelectorAll('polygon');

    const tl = gsap.timeline({
      onComplete: () => {
        gsap.to(container, {
          opacity: 0,
          duration: 0.4,
          ease: 'power2.in',
          onComplete: () => {
            container.style.display = 'none';
            container.style.pointerEvents = 'none';
            completeInitialLoad();
          },
        });
      },
    });

    // Draw paths
    paths.forEach((path, index) => {
      tl.to(path, { strokeDashoffset: 0, duration: 0.6, ease: 'power2.out' }, index * 0.1);
      tl.to(path, { fillOpacity: 1, duration: 0.25, ease: 'power1.in' }, `-=${0.15}`);
    });

    // Draw polygons
    polygons.forEach((polygon, index) => {
      tl.to(polygon, { strokeDashoffset: 0, duration: 0.5, ease: 'power2.out' }, paths.length * 0.1 + index * 0.08);
      tl.to(polygon, { fillOpacity: 1, duration: 0.25, ease: 'power1.in' }, `-=${0.15}`);
    });

    // Brief pause before fade
    tl.to({}, { duration: 0.3 });
  }

  function skipInitialAnimation() {
    const container = document.getElementById('initial-loader');
    if (container) {
      container.style.display = 'none';
      container.style.pointerEvents = 'none';
    }
    completeInitialLoad();
  }

  function completeInitialLoad() {
    initialLoaderComplete = true;
    markVisited();
    window.dispatchEvent(new CustomEvent('loading-animation-complete'));
  }

  // Page transition functions
  function showPageTransition() {
    if (!initialLoaderComplete) return; // Don't show if initial load not complete
    
    const transition = document.getElementById('page-transition');
    if (!transition) return;
    
    isNavigating = true;
    transition.style.visibility = 'visible';
    transition.style.pointerEvents = 'auto';
    gsap.to(transition, {
      opacity: 1,
      duration: 0.15,
      ease: 'power1.in',
    });
  }

  function hidePageTransition() {
    const transition = document.getElementById('page-transition');
    if (!transition) return;
    
    gsap.to(transition, {
      opacity: 0,
      duration: 0.25,
      ease: 'power2.out',
      onComplete: () => {
        transition.style.visibility = 'hidden';
        transition.style.pointerEvents = 'none';
        isNavigating = false;
      },
    });
  }

  // Initialize
  function init() {
    // Reset transition overlay state
    const transition = document.getElementById('page-transition');
    if (transition) {
      transition.style.opacity = '0';
      transition.style.visibility = 'hidden';
      transition.style.pointerEvents = 'none';
    }

    // Handle initial loader
    const container = document.getElementById('initial-loader');
    
    if (isFirstVisit()) {
      // First visit - run full animation
      if (container) {
        container.style.display = 'flex';
        container.style.opacity = '1';
      }
      // Small delay to ensure everything is rendered
      requestAnimationFrame(() => {
        runInitialAnimation();
      });
    } else {
      // Return visit - skip animation
      skipInitialAnimation();
    }
  }

  // Start on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Handle Astro page transitions
  document.addEventListener('astro:before-preparation', () => {
    showPageTransition();
  });

  document.addEventListener('astro:page-load', () => {
    // After a page transition, hide the overlay
    if (isNavigating) {
      // Small delay to let content render
      requestAnimationFrame(() => {
        hidePageTransition();
      });
    }
    
    // Ensure initial loader stays hidden on subsequent loads
    const container = document.getElementById('initial-loader');
    if (container && initialLoaderComplete) {
      container.style.display = 'none';
    }
  });

  // Also handle after-swap for faster response
  document.addEventListener('astro:after-swap', () => {
    // Ensure loader elements are in correct state after swap
    const container = document.getElementById('initial-loader');
    if (container) {
      container.style.display = 'none';
      container.style.pointerEvents = 'none';
    }
  });
</script>
