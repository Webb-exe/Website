---
const links = [
  { href: "/#about", label: "About" },
  { href: "/team", label: "Team" },
  { href: "/sponsors", label: "Sponsors" },
  { href: "/contact", label: "Contact" },
];
---

<nav id="main-nav" class="fixed inset-x-0 top-0 z-1000 pointer-events-none">
  <div class="section-wrapper pt-4 sm:pt-5">
    <div class="section-content flex items-start justify-between gap-3">
      <a href="/" class="pointer-events-auto block drop-shadow-[0_2px_8px_rgb(0_0_0/0.6)] transition-opacity hover:opacity-80" aria-label="359 Webb.exe home">
        <img src="/logo-wordmark.svg" alt="" class="mt-3 h-4 w-auto sm:h-[1.15rem]" />
      </a>

      <div class="pill pointer-events-auto hidden md:flex items-center gap-1 p-1">
        {links.map(({ href, label }) => (
          <a href={href} class="rounded-full px-4 py-2 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white">{label}</a>
        ))}
      </div>

      <div class="pointer-events-auto md:hidden flex flex-col items-end">
        <button
          id="mobile-menu-btn"
          class="pill flex h-11 w-11 flex-col items-center justify-center gap-1.5"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="menu-line"></span>
          <span class="menu-line"></span>
        </button>

        <div id="mobile-menu" class="mt-2 grid w-56 transition-[grid-template-rows,opacity] duration-300 ease-out" hidden>
          <div class="overflow-hidden">
            <div class="pill flex flex-col rounded-3xl! p-2">
              {links.map(({ href, label }) => (
                <a href={href} class="mobile-menu-link rounded-2xl px-4 py-3 text-base text-gray-200 hover:bg-white/10">{label}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  #main-nav {
    transition: transform 0.35s ease, opacity 0.35s ease;
  }
  #main-nav.is-hidden {
    transform: translateY(-120%);
    opacity: 0;
  }

  .menu-line {
    width: 18px;
    height: 1.5px;
    background: #d4d4d4;
    transition: transform 0.3s ease;
  }
  .is-open .menu-line:nth-child(1) { transform: translateY(3.5px) rotate(45deg); }
  .is-open .menu-line:nth-child(2) { transform: translateY(-3.5px) rotate(-45deg); }

  #mobile-menu { grid-template-rows: 0fr; opacity: 0; }
  #mobile-menu:not([hidden]) { display: grid; }
  #mobile-menu.is-open { grid-template-rows: 1fr; opacity: 1; }
</style>

<script>
  const nav = document.getElementById("main-nav")!;
  const button = document.getElementById("mobile-menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;

  let open = false;
  let lastY = 0;

  function setOpen(next: boolean) {
    open = next;
    button.classList.toggle("is-open", open);
    button.setAttribute("aria-expanded", String(open));
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add("is-open"));
      nav.classList.remove("is-hidden");
    } else {
      menu.classList.remove("is-open");
      menu.addEventListener("transitionend", () => { if (!open) menu.hidden = true; }, { once: true });
    }
  }

  function onScroll() {
    const y = window.scrollY;
    if (!open) {
      if (y - lastY > 4 && y > 160) nav.classList.add("is-hidden");
      else if (lastY - y > 4) nav.classList.remove("is-hidden");
    }
    lastY = y;
  }

  button.addEventListener("click", () => setOpen(!open));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  window.addEventListener("scroll", onScroll, { passive: true });

  // Nav element persists across navigations; reset its state for each new page.
  document.addEventListener("astro:page-load", () => {
    if (open) setOpen(false);
    lastY = window.scrollY;
    nav.classList.remove("is-hidden");
  });
</script>
