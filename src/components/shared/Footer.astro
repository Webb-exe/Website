---
import { socials } from "../../data/socials";
import { contact } from "../../data/contact";

const year = new Date().getFullYear();
const links = [
  { href: socials.instagram, label: "Instagram" },
  { href: socials.youtube, label: "YouTube" },
  { href: socials.github, label: "GitHub" },
  { href: socials.ftcscout, label: "FTC Scout" },
];
---

<footer id="main-footer" class="bg-dark relative section-wrapper py-14 sm:py-20 overflow-hidden">
  <div class="section-content">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <img src="/logo-stacked.svg" alt="Webb.exe Robotics" class="h-20 w-auto" />
        <p class="hand mt-5 text-2xl">Claremont, California</p>
        <a href={`mailto:${contact.email}`} class="mt-2 inline-block text-sm t-muted hover:text-white transition-colors">{contact.email}</a>
      </div>

      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer" class="t-muted hover:text-white transition-colors">{label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-dashed line pt-6 text-xs t-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Team 359 Webb.exe</p>
      <div class="flex gap-5">
        <a href="/contact" class="hover:text-gray-300 transition-colors">Contact</a>
        <a href="/brand" class="hover:text-gray-300 transition-colors">Brand kit</a>
      </div>
    </div>
  </div>
</footer>
