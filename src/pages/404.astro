---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import notfound from "../assets/notfound.png";
---

<Layout title="Page not found | 359 Webb.exe">
  <section class="bg-dark relative section-wrapper min-h-svh flex items-center pt-32 pb-20">
    <div class="section-content grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <span class="enter label" style="--i: 0">Error 404</span>
        <h1 class="enter display mt-6 text-5xl sm:text-7xl lg:text-8xl" style="--i: 1">359 Webb.exe has stopped responding.</h1>
        <p class="enter mt-6 max-w-md text-lg leading-relaxed t-muted" style="--i: 2">
          This page has either moved or never existed. The robot is fine.
        </p>
        <div class="enter mt-10" style="--i: 3">
          <a href="/" class="btn">Back home</a>
        </div>
      </div>
      <figure class="enter polaroid tilt-l mx-auto w-full max-w-xs lg:col-span-5" style="--i: 2">
        <span class="tape"></span>
        <Image src={notfound} alt="" width={600} />
        <figcaption class="caption">404, {new Date().getFullYear()}</figcaption>
      </figure>
    </div>
  </section>
</Layout>
